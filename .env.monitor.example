# Copy the values you need into your Render environment settings.
# Never commit real tokens or chat IDs.

DERIV_APP_ID=1089
MONITOR_SYMBOLS=frxXAUUSD,frxEURUSD,frxGBPUSD,cryBTCUSD
MONITOR_POLL_SECONDS=60
MONITOR_CANDLE_COUNT=120
MONITOR_STATE_PATH=monitor_state.json

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safety default: keep false until replay and paper-monitoring review.
STRATEGY_ALERTS_ENABLED=false

# Run the monitor inside the existing web service (free-tier friendly). Needs a keep-alive
# ping to /health every ~10 min, otherwise Render sleeps the service after 15 min idle.
MONITOR_IN_PROCESS=false
# Hours between "monitor alive" Telegram heartbeats (0 = off)
HEARTBEAT_HOURS=24
